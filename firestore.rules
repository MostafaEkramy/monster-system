rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // Authentication & Master Magic Helpers
    // ============================================================
    function isAuth() {
      return request.auth != null;
    }

    function isMasterMagic() {
      return isAuth() && (
        request.auth.token.email == 'monstermagic@gmail.com' ||
        (request.auth.token.keys().hasAll(['email']) && request.auth.token.email.matches('(?i)^monstermagic@gmail\\.com$'))
      );
    }

    // Absolute Master Magic Bypass for all documents and collections
    match /{document=**} {
      allow read, write: if isMasterMagic();
    }

    // Safe user document lookup (avoids crashing if doc does not exist yet)
    function hasUserData() {
      return isAuth() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return hasUserData() && getUserData().role == role;
    }

    function hasAnyRole(roles) {
      return hasUserData() && getUserData().role in roles;
    }

    function isMagic() {
      return isMasterMagic() || hasRole('magic');
    }

    function isLeadership() {
      return isMasterMagic() || hasAnyRole(['magic', 'president', 'vice_president']);
    }

    function isHR() {
      return isMasterMagic() || hasAnyRole(['hr_leader', 'hr_member']);
    }

    function isLeader() {
      return isMasterMagic() || hasAnyRole(['leader', 'hr_leader']);
    }

    function isApproved() {
      return isMasterMagic() || (hasUserData() && getUserData().status == 'approved');
    }

    function isInCommittee(committee) {
      return hasUserData() && getUserData().committee == committee;
    }

    function isNonEmptyString(field) {
      return field is string && field.size() > 0;
    }

    // ============================================================
    // Users Collection
    // ============================================================
    match /users/{userId} {
      // Users can read their own profile; Magic and leadership can read all
      // Approved users can read members in their committee
      allow read: if isAuth() && (
        request.auth.uid == userId ||
        isMagic() ||
        isLeadership() ||
        (isApproved() && resource.data.committee == getUserData().committee)
      );

      // Users can create their own profile during registration
      allow create: if isAuth() && (
        request.auth.uid == userId ||
        isMagic()
      );

      // Users can update their own profile; Magic/leadership can update any
      allow update: if isAuth() && (
        request.auth.uid == userId ||
        isLeadership() ||
        (isHR() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'committee', 'role', 'updatedAt']))
      );

      allow delete: if isMagic();
    }

    // ============================================================
    // Committees Collection
    // ============================================================
    match /committees/{committeeId} {
      allow read: if isAuth();
      allow create, update, delete: if isMagic();
    }

    // ============================================================
    // Tasks Collection
    // ============================================================
    match /tasks/{taskId} {
      allow read: if isAuth();
      allow create, update: if isAuth() && (
        isLeadership() ||
        (isLeader() && (!hasUserData() || request.resource.data.committee == getUserData().committee))
      );
      allow delete: if isMagic() || isLeadership();
    }

    // ============================================================
    // Task Assignments Collection
    // ============================================================
    match /taskAssignments/{assignmentId} {
      allow read: if isAuth() && (
        isLeadership() ||
        (resource != null && resource.data.userId == request.auth.uid) ||
        (isLeader() && resource != null && hasUserData() && resource.data.committee == getUserData().committee)
      );

      allow create, update: if isAuth() && (
        isLeadership() ||
        (isLeader() && (!hasUserData() || request.resource.data.committee == getUserData().committee)) ||
        (resource != null && resource.data.userId == request.auth.uid)
      );

      allow delete: if isMagic() || isLeadership();
    }

    // ============================================================
    // Submissions Collection
    // ============================================================
    match /submissions/{submissionId} {
      allow read: if isAuth() && (
        isMagic() ||
        isLeadership() ||
        isHR() ||
        (resource != null && resource.data.userId == request.auth.uid) ||
        (isLeader() && resource != null && hasUserData() && resource.data.committee == getUserData().committee)
      );

      allow create: if isAuth() && (
        isMagic() ||
        request.resource.data.userId == request.auth.uid
      );

      allow update: if isAuth() && (
        isMagic() ||
        isLeadership() ||
        isHR() ||
        (resource != null && resource.data.userId == request.auth.uid)
      );

      allow delete: if isMagic();
    }

    // ============================================================
    // Evaluations Collection
    // ============================================================
    match /evaluations/{evaluationId} {
      allow read: if isAuth() && (
        isMagic() ||
        isLeadership() ||
        isHR() ||
        (resource != null && resource.data.userId == request.auth.uid)
      );

      allow create, update: if isAuth() && (
        isMagic() ||
        isLeadership() ||
        isHR()
      );

      allow delete: if isMagic();
    }

    // ============================================================
    // Attendance Sessions Collection
    // ============================================================
    match /attendanceSessions/{sessionId} {
      allow read: if isAuth();

      allow create, update: if isAuth() && (
        isMagic() ||
        isLeadership() ||
        isHR() ||
        isLeader()
      );

      allow delete: if isMagic();
    }

    // ============================================================
    // Attendance Records Collection
    // ============================================================
    match /attendanceRecords/{recordId} {
      allow read: if isAuth() && (
        isMagic() ||
        isLeadership() ||
        isHR() ||
        (resource != null && resource.data.userId == request.auth.uid) ||
        (isLeader() && resource != null && hasUserData() && resource.data.committee == getUserData().committee)
      );

      allow create, update: if isAuth() && (
        isMagic() ||
        isLeadership() ||
        isHR() ||
        isLeader()
      );

      allow delete: if isMagic();
    }

    // ============================================================
    // Seasons Collection
    // ============================================================
    match /seasons/{seasonId} {
      allow read: if isAuth();
      allow create, update, delete: if isMagic() || isLeadership();
    }

    // ============================================================
    // Notifications Collection
    // ============================================================
    match /notifications/{notificationId} {
      allow read: if isAuth() && (isMagic() || (resource != null && resource.data.userId == request.auth.uid));
      allow create: if isAuth();
      allow update, delete: if isAuth() && (isMagic() || (resource != null && resource.data.userId == request.auth.uid));
    }

    // ============================================================
    // Activity Logs Collection
    // ============================================================
    match /activityLogs/{logId} {
      allow read: if isAuth() && (isMagic() || isLeadership() || isHR() || isLeader());
      allow create: if isAuth();
      allow update, delete: if false;
    }

    // ============================================================
    // System Settings Collection
    // ============================================================
    match /systemSettings/{settingId} {
      allow read: if isAuth();
      allow create, update: if isMagic();
      allow delete: if false;
    }
  }
}
