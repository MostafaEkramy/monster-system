rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAuth() {
      return request.auth != null;
    }

    function isMasterMagic() {
      return isAuth() && (
        request.auth.token.email == 'monstermagic@gmail.com' ||
        (request.auth.token.keys().hasAll(['email']) && request.auth.token.email.matches('(?i)^monstermagic@gmail\\.com$'))
      );
    }

    // Absolute Master Magic Bypass for all storage objects
    match /{allPaths=**} {
      allow read, write: if isMasterMagic();
    }

    // Profile Images
    match /profile-images/{userId}/{allPaths=**} {
      allow read: if isAuth();
      allow write: if isAuth() && (isMasterMagic() || request.auth.uid == userId);
      allow delete: if isAuth() && (isMasterMagic() || request.auth.uid == userId);
    }

    // Task Attachments
    match /task-attachments/{taskId}/{allPaths=**} {
      allow read: if isAuth();
      allow write: if isAuth();
      allow delete: if isMasterMagic();
    }

    // Submissions
    match /submissions/{submissionId}/{allPaths=**} {
      allow read: if isAuth();
      allow write: if isAuth();
      allow delete: if isMasterMagic();
    }
  }
}
